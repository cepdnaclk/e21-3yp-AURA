{
	"info": {
		"_postman_id": "a4d334e3-3e12-421c-92b1-123456789abc",
		"name": "AURA Full Integration Flow (10 Tests)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
